{
  "name": "fivebar",
  "version": "0.1.0",
  "private": true,
  "description": "Five checks before every push: free scanners, your coding agent and a 5/5 review gate, running on your own PC.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/app/main.js",
  "bin": {
    "fivebar": "dist/cli/index.js"
  },
  "scripts": {
    "build": "npm run build:node && npm run build:ui",
    "build:node": "tsup",
    "build:ui": "vite build --config vite.config.ts",
    "dev:ui": "vite --config vite.config.ts",
    "serve": "node dist/cli/index.js serve",
    "app": "electron .",
    "test": "vitest run --config vitest.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "fflate": "^0.8.3",
    "sql.js": "^1.15.2",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sql.js": "^1.4.11",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.1.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsup": "^9.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
